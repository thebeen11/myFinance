# ---------------------------------------------------------------------------
# Copy the API block to apps/api/.env and the web block to apps/web/.env.local
# Supabase dashboard -> Project Settings -> Database -> Connection string
# ---------------------------------------------------------------------------

# --- apps/api -------------------------------------------------------------

# SESSION pooler (port 5432). The Nest API is a long-lived server, so it wants
# session mode. Use the POOLER host shown in the dashboard, not
# db.<project-ref>.supabase.co — the direct host is IPv6-only on new projects
# and will not resolve on most home/office networks.
# Deploying to a serverless runtime later? Point this at the TRANSACTION pooler
# (port 6543, add ?pgbouncer=true) instead.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Used by `prisma db push` / `prisma migrate` so DDL never runs through a
# transaction pooler. Same session-pooler URL is fine.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# node-postgres pool size per process. Defaults to 10 locally and 1 on Vercel,
# where every warm function instance holds its own pool.
# DATABASE_POOL_MAX=10

PORT=8001
NODE_ENV=development

# Comma-separated. On Vercel this MUST list the deployed web origin, or every
# browser call fails CORS even though the function itself returns 200.
CORS_ORIGINS="http://localhost:3000"

# Signs access tokens. Generate with: openssl rand -base64 48
# Rotating it invalidates every access token immediately; refresh tokens survive,
# because those live in the database rather than in a signature.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Shared code required by POST /auth/register. Registration is CLOSED when this is
# unset — a missing value fails the request rather than opening the door.
INVITE_CODE="change-me"

# Reads receipt photos for POST /receipts/scan. Google AI Studio -> Get API key.
# Scanning is DISABLED when this is unset: that one route fails and nothing else
# does, so the API still boots and every other endpoint keeps working.
GEMINI_API_KEY="change-me"

# Optional. Defaults to the best generally available reader. gemini-3.8-flash is
# several times cheaper and close on receipt-sized text — switch here, not in code,
# if a scan ever runs near Vercel's 30s function limit.
# GEMINI_MODEL="gemini-3.1-pro-preview"

# --- apps/web -------------------------------------------------------------

NEXT_PUBLIC_API_URL="http://localhost:8001"
